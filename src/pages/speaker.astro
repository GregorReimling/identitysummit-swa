---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Speaker | Cloud Identity Summit">
    <main class="max-w-4xl mx-auto px-4 py-32 w-full flex-grow text-center">
        <div class="inline-block bg-blue-900/30 border border-blue-800/50 rounded-full px-4 py-1.5 mb-6">
            <span class="text-blue-400 text-sm font-semibold tracking-wide uppercase">Speaker</span>
        </div>
        
        <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight mb-16">
            Speaker 2026
        </h1>

        <!-- Dezentere Keynote-Integration -->
        <div class="mb-12 text-left bg-slate-900/40 border border-slate-800/60 rounded-2xl p-6 flex flex-col sm:flex-row items-center sm:items-start gap-6 hover:border-slate-700 transition-colors">
            <img 
                src="/images/speakers/eric-woodruff.jpg" 
                alt="Eric Woodruff" 
                class="w-24 h-24 rounded-full border-2 border-slate-700 object-cover shrink-0" 
                onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 100 100\'><rect width=\'100\' height=\'100\' fill=\'%231e293b\'/><text x=\'50\' y=\'50\' font-family=\'Arial\' font-size=\'40\' fill=\'%23475569\' dominant-baseline=\'middle\' text-anchor=\'middle\'>EW</text></svg>'"
            />
            
            <div>
                <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 mb-1">
                    <h3 class="text-xl font-bold text-white">Eric Woodruff</h3>
                    <span class="bg-blue-900/30 text-blue-400 text-[10px] font-bold px-2 py-0.5 rounded border border-blue-800/50 uppercase tracking-wider">
                        Keynote / USA
                    </span>
                </div>
                <p class="text-blue-300 text-sm font-medium mb-3">"Identity Security Kindergeburtstag"</p>
                <p class="text-slate-400 text-sm leading-relaxed mb-3">
                    You're all invited to the 14th birthday of identity being the "new" security perimeter! And what better way to celebrate than to take a deep look at its slightly strained relationship within cybersecurity...
                </p>
                <a href="/agenda" class="text-blue-400 hover:text-blue-300 text-sm font-medium transition-colors">
                    View in Agenda →
                </a>
            </div>
        </div>

        <!-- Sessionize Speaker Wall -->
        <div class="sessionize-wrap">
            <script
                is:inline
                type="text/javascript"
                src="https://sessionize.com/api/v2/zypgzww2/view/SpeakerWall"
            ></script>
        </div>
    </main>
</Layout>

<style>
  .sessionize-wrap {
    background: var(--bg-card);
    border: 1px solid rgba(120,120,200,0.15);
    border-radius: 16px;
    padding: 32px;
    overflow-x: auto;
    text-align: left;
  }
</style>